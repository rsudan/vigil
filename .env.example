# Copy to .env for local runs. Nothing here is required to start the app.

# Database. Leave unset to use the embedded PGLite database persisted under .pglite/.
# DATABASE_URL=postgres://user:pass@host/db
# PGLITE_DATA_DIR=.pglite            # or memory:// to keep nothing between restarts

# Encryption of stored API keys (AES-256-GCM). Falls back to BETTER_AUTH_SECRET,
# then to a random secret written once to .data/key-secret. Rotating it means
# users re-enter their keys.
# VIGIL_KEY_SECRET=change-me-to-a-long-random-string

# Better Auth session secret. Required on a deployment.
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=https://vigil.example.org

# Who may spend keys set in this environment: admins (default) | all | none
# VIGIL_PLATFORM_KEYS_FOR=admins
# XAI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# PERPLEXITY_API_KEY=
# EXA_API_KEY=
# JINA_API_KEY=

# Close self-registration once the team is on board (first account is admin).
# VITE_DISABLE_SIGNUP=true

# Show "Continue with Google / X" only when the Grok auth broker is configured.
# VITE_GROK_OAUTH=true
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=

# The whole document is always read. When it exceeds the provider's window it is read in
# several passes and consolidated. This caps the per-pass size for every provider (tests use it).
# VIGIL_EXTRACT_CHARS=60000

# Offline test mode: a deterministic stand-in for the model, Exa and Jina. Never active in production.
# VIGIL_LLM_MOCK=1
